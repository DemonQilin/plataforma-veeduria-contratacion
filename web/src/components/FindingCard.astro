---
interface Props {
  /** Ancla de la pantalla de destino, sin «#». */
  screenId: string;
  /** Texto de la migaja, por ejemplo «4 · La comparación». */
  crumb: string;
  title: string;
  /** Texto del enlace final, por ejemplo «Ver la comparación». */
  more: string;
}

const { screenId, crumb, title, more } = Astro.props;
const base = import.meta.env.BASE_URL;
const href = `${base}#${screenId}`;
---

<article class="finding">
  <a class="crumb caption" href={href}>{crumb}</a>
  <h2>{title}</h2>
  <slot />
  <a class="more caption" href={href}>{more} →</a>
</article>

<style>
  .finding {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    min-width: 0;
    padding: var(--space-3);
    background: var(--surface-raised);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
  }

  .finding :global(h2),
  .finding :global(p) {
    margin: 0;
  }

  .finding :global(p:not(.caption)) {
    font-size: 15px;
    line-height: 22px;
  }

  @media (min-width: 900px) {
    .finding {
      padding: 24px;
    }
  }
</style>
