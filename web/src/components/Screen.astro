---
import { neighbors, SCREENS } from '../lib/screens';

interface Props {
  id: string;
  heading?: boolean;
}

const { id, heading = true } = Astro.props;
const { number, previous, next } = neighbors(id);
const title = SCREENS[number - 1]?.title ?? id;
const base = import.meta.env.BASE_URL;
const hasTitle = Astro.slots.has('title');
// Un solo h1 en la página (el titular de la portada); las demás pantallas abren con h2.
const Heading = id === 'portada' ? 'h1' : 'h2';
const headingClass = Heading === 'h1' ? undefined : 'screen-title';
---

<section id={id} aria-labelledby={`${id}-title`} class="screen">
  {
    hasTitle ? (
      <Heading id={`${id}-title`} class={headingClass}>
        <slot name="title" />
      </Heading>
    ) : heading ? (
      <Heading id={`${id}-title`} class={headingClass}>
        <span class="caption">Pantalla {number}</span>
        <br />
        {title}
      </Heading>
    ) : (
      <Heading id={`${id}-title`} class="visually-hidden">{title}</Heading>
    )
  }
  <slot />
  <nav class="pager" aria-label={`Navegación de la pantalla ${number}`}>
    {previous ? <a href={`${base}#${previous.id}`}>← {previous.title}</a> : <span />}
    {next ? <a href={`${base}#${next.id}`}>{next.title} →</a> : <span />}
  </nav>
</section>

<style>
  .screen {
    padding: var(--space-4) 0;
    scroll-margin-top: var(--space-3);
    border-bottom: 2px solid var(--chart-grid);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }
</style>
