---
import BarTable from '../components/BarTable.astro';
import type { BarRow } from '../components/BarTable.astro';
import Base from '../layouts/Base.astro';
import FindingCard from '../components/FindingCard.astro';
import Explorer from '../components/Explorer';
import Figure from '../components/Figure.astro';
import Screen from '../components/Screen.astro';
import { getMetadata, getQuality } from '../lib/data';
import { buildExplorer } from '../lib/explorer';
import { formatDate, formatMonth, formatNumber, formatPercent } from '../lib/format';
import { SCREENS } from '../lib/screens';
import type { I2YearCell } from '../lib/selectors';
import {
  comparisonWindows,
  directAwardJanuary,
  i2Extremes,
  i2ByYear,
  reconciliationMonths,
  restrictions,
} from '../lib/selectors';

const metadata = getMetadata();
const pending = SCREENS.filter((screen) => screen.id === 'hacia-2027');
// Pantalla 6: el explorador recibe las cifras ya elegidas, ordenadas y con formato (S6).
const explorer = buildExplorer();
const explorerLastYear = explorer.indicators[0]?.years.at(-1)?.year;
const REPO_URL = 'https://github.com/DemonQilin/plataforma-veeduria-contratacion';
const CONTACT = 'juanvelez1113670@correo.itm.edu.co';

// Portada (pantalla 1): solo elige celdas de data/outputs/ (S6). Los anchos de barra
// son una escala visual, no una cifra publicada.
const roleLabel = (role: I2YearCell['role']) => (role === 'treatment' ? 'Elecciones' : 'Comparación');
const tone = (role: I2YearCell['role']): 'treatment' | 'control' => (role === 'treatment' ? 'treatment' : 'control');
const percent = (year: I2YearCell | undefined) =>
  year?.cell.ratio == null ? 'datos insuficientes' : formatPercent(year.cell.ratio);
const SCALE = 72;
const ratioRows = (years: I2YearCell[], withN = false): BarRow[] =>
  years.map((year) => ({
    label: String(year.year),
    sub: roleLabel(year.role),
    display: percent(year),
    note: withN
      ? `${formatNumber(year.cell.numerator ?? 0)} de ${formatNumber(year.cell.denominator ?? 0)} contratos`
      : undefined,
    width: (year.cell.ratio ?? 0) * SCALE,
    tone: tone(year.role),
  }));
const descriptionOf = (rows: readonly BarRow[]) =>
  rows.map((row) => `${row.label}, ${row.display}${row.note ? ` (${row.note})` : ''}`).join('; ');

const base = i2ByYear({ variant: null, measure: 'count' });
const baseRows = ratioRows(base, true);
const baseControl = i2Extremes(base, 'control');

const service = i2ByYear({ variant: 'service_contract', measure: 'count' });
const serviceRows = ratioRows(service);
const nonService = i2ByYear({ variant: 'non_service_contract', measure: 'count' });
const nonServiceControl = i2Extremes(nonService, 'control');

const spans = i2ByYear({ variant: 'spans_restriction', measure: 'count' });
const spansRows = ratioRows(spans);
const spans2025 = spans.find((year) => year.year === 2025);

const january = directAwardJanuary();
const januaryMax = Math.max(...january.map((row) => row.contract_count));
const roleOfYear = new Map(base.map((year) => [String(year.year), year.role]));
const januaryRows: BarRow[] = january.map((row) => {
  const role = roleOfYear.get(row.period.slice(0, 4));
  return {
    label: `Enero ${row.period.slice(0, 4)}`,
    sub: roleLabel(role),
    display: formatNumber(row.contract_count),
    width: (row.contract_count / januaryMax) * SCALE,
    tone: tone(role),
  };
});

const list = restrictions();
const timelineStart = Date.UTC(Number(list[0]?.start.slice(0, 4)), 0, 1);
const timelineEnd = Date.UTC(Number(list.at(-1)?.end.slice(0, 4)) + 1, 0, 1);
const place = (iso: string) => ((Date.parse(`${iso}T00:00:00Z`) - timelineStart) / (timelineEnd - timelineStart)) * 100;
const scopeLabel = { direct_award: 'Contratación directa', interadministrative: 'Convenios' } as const;
const timelineRows: BarRow[] = list.map((item) => ({
  label: item.start.slice(0, 4) === item.end.slice(0, 4) ? item.start.slice(0, 4) : `${item.start.slice(0, 4)}–${item.end.slice(0, 4)}`,
  sub: `${scopeLabel[item.scope]}${item.status === 'upcoming' ? ' · próxima' : ''}`,
  display: `del ${formatDate(item.start)} al ${formatDate(item.end)}`,
  width: place(item.end) - place(item.start),
  offset: place(item.start),
  tone: item.scope === 'direct_award' ? 'restriction' : 'dashed',
}));
const latestJanuary = january.at(-1);
const peakJanuary = january.toSorted((a, b) => b.contract_count - a.contract_count)[0];
const directRestrictions = restrictions('direct_award');
const ruleSource = directRestrictions[0]?.sources[0];

// Pantalla 4: solo elige celdas de I2 y fechas de comparison_windows (S6).
const latestTreatment = base.findLast((year) => year.role === 'treatment');
const windows = comparisonWindows();
const firstControlWindow = windows.find((window) => window.role === 'control');
// Pantalla 5: celdas de I2 por tipo de contrato y de la variante spans_restriction (S6).
const serviceTreatment = service.findLast((year) => year.role === 'treatment');
const nonServiceSameYear = nonService.find((year) => year.year === serviceTreatment?.year);
const spansControl = i2Extremes(spans, 'control').max;
const spansTreatment = spans.filter((year) => year.role === 'treatment');
const referenceEnds = windows.filter((window) => window.role === 'treatment');
// Pantalla 7: calidad de los datos, tal cual de quality.json (S6).
const quality = getQuality();
const months = reconciliationMonths();
const threshold = quality?.reconciliation.threshold;
const belowMonths = months.filter((month) => month.below_threshold);
const monthRows: BarRow[] = belowMonths.map((month) => ({
  label: formatMonth(month.period),
  display: month.shared_share == null ? 'datos insuficientes' : formatPercent(month.shared_share),
  note: `${formatNumber(month.shared_count)} de ${formatNumber(month.union_count)} contratos`,
  width: (month.shared_share ?? 0) * SCALE,
  tone: 'restriction',
}));
const truncated = quality?.truncated_rows.rows;
const unassigned = quality?.unassigned_share.district;
const exclusions = quality?.single_bidder_exclusions;
const switchOptions = [
  { id: 'numero', label: 'Por número de contratos', figure: 'concentracion-enero-por-numero', note: 'Cifra titular: definición base, por número de contratos.' },
  { id: 'valor', label: 'Por valor', figure: 'concentracion-enero-por-valor', note: 'Por valor se usa el valor inicial, sin operaciones de crédito público. La señal es menos clara que por número; por eso la cifra titular es la del número de contratos.' },
  { id: 'sin-interadministrativos', label: 'Sin interadministrativos', figure: 'concentracion-enero-sin-interadministrativos', note: 'Sin convenios interadministrativos, ni en los contratos de la ventana ni en el total, porque su peso cambia entre años: en 2023 no hubo de julio a octubre por la restricción local.' },
] as const;
---

<Base
  title="Veeduría de contratación · Alcaldía de Medellín"
  description="Señales para revisar la contratación directa de la Alcaldía de Medellín alrededor de la Ley de Garantías."
>
  <Screen id="portada">
    <span slot="title" class="display">
      En 2022 y 2026, más de la mitad de la contratación directa se firmó en enero.
    </span>
    <p class="caption">
      {
        metadata
          ? `Hallazgo principal · Medellín · fecha de corte ${formatDate(metadata.cutoff_date)}.`
          : 'Los datos todavía no están disponibles.'
      }
    </p>
    <p class="caption">
      Antes de que empezara la restricción de la Ley de Garantías. Del 1 de enero
      {metadata ? ` al ${formatDate(metadata.cutoff_date)}` : ''}, por número de contratos.
    </p>
    <p><a class="start" href="#la-regla">Empezar el recorrido</a></p>

    <div class="cover-grid">
      <FindingCard screenId="la-comparacion" crumb="4 · La comparación" level="h2" title="Contratación directa firmada en la ventana de enero" more="Ver la comparación">
        <BarTable caption={`Contratación directa firmada en la ventana de enero, por número de contratos: ${descriptionOf(baseRows)}.`} rows={baseRows} valueLabel="Proporción" />
        {baseControl.min && baseControl.max && (
          <p>En los años sin restricción, la proporción estuvo entre {percent(baseControl.min)} y {percent(baseControl.max)}.</p>
        )}
      </FindingCard>
    </div>

    <h2 class="cover-h2">Lo que muestran los datos</h2>
    <div class="cover-grid cover-grid--pair">
      <FindingCard screenId="la-regla" crumb="2 · La regla" title="La contratación directa se restringió dos veces: en 2022 y en 2026" more="Ver la regla">
        <BarTable caption={`Periodos de restricción: ${timelineRows.map((row) => `${row.sub} ${row.display}`).join('; ')}.`} rows={timelineRows} valueLabel="Periodo" showValue={false} />
        <p>Del {directRestrictions.map((item) => `${formatDate(item.start)} al ${formatDate(item.end)}`).join(' y del ')}.</p>
      </FindingCard>

      <FindingCard screenId="el-patron" crumb="3 · El patrón" title="Enero es el mes con más contratación directa de cada año" more="Ver el patrón">
        <BarTable caption={`Contratos directos firmados en enero: ${descriptionOf(januaryRows)}.`} rows={januaryRows} valueLabel="Contratos" />
        <p>Durante las restricciones, la contratación directa casi se detiene y vuelve a subir cuando terminan.</p>
      </FindingCard>

      <FindingCard screenId="la-objecion" crumb="5 · La objeción" title="En prestación de servicios, la proporción de enero es mayor en los años con elecciones" more="Ver la objeción">
        <BarTable caption={`Prestación de servicios, proporción firmada en la ventana de enero: ${descriptionOf(serviceRows)}.`} rows={serviceRows} valueLabel="Proporción" />
        {nonServiceControl.min && nonServiceControl.max && (
          <p>En el resto de tipos de contrato va de {percent(nonServiceControl.min)} a {percent(nonServiceControl.max)}.</p>
        )}
      </FindingCard>

      <FindingCard screenId="la-objecion" crumb="5 · La objeción" title="La duración de los contratos de enero no separa los años" more="Ver la objeción">
        <p class="tag">No concluyente</p>
        <BarTable caption={`Contratos de enero que terminan después de la restricción de referencia: ${descriptionOf(spansRows)}.`} rows={spansRows} valueLabel="Proporción" />
        {spans2025 && (
          <p>Contratos de enero que terminan después de la restricción. En 2025, año de comparación, también llega a {percent(spans2025)}.</p>
        )}
      </FindingCard>
    </div>
  </Screen>
  <Screen id="la-regla">
    <span slot="title">¿Qué es la Ley de Garantías?</span>
    <p class="caption">2 · La regla</p>
    <div class="rule-intro">
      <p>La Ley de Garantías (Ley 996 de 2005) busca que la contratación pública no se use con fines electorales. Por eso, desde cuatro meses antes de la elección presidencial y hasta la segunda vuelta, las entidades del Estado no pueden firmar contratos por contratación directa, salvo excepciones como la defensa, la seguridad y las emergencias.</p>
      <div class="definition">
        <strong>Qué restringe.</strong> En el calendario electoral que usa este tablero, la restricción de contratación directa
        corresponde a las elecciones presidenciales (2022 y 2026); la de convenios interadministrativos, a las
        elecciones locales (2023 y 2027) y a las de Congreso (2026).
        {ruleSource && <> Fuente: {ruleSource}.</>}
      </div>
    </div>
    <Figure id="periodos-de-restriccion" number="2.1" />
    <p class="legend">
      <span><span class="swatch swatch--direct"></span> Restricción de la contratación directa</span>
      <span><span class="swatch swatch--agreement"></span> Restricción de convenios interadministrativos</span>
    </p>
  </Screen>
  <Screen id="el-patron">
    <span slot="title">¿Qué pasa con la contratación alrededor de esas fechas?</span>
    <p class="caption">3 · El patrón</p>
    <div class="pattern-grid">
      <article class="pattern-card">
        <p class="caption number">3.1</p>
        <h3>Enero es el mes con más contratación directa de cada año</h3>
        {
          latestJanuary && (
            <p class="big-number">
              <span class="big">{formatNumber(latestJanuary.contract_count)}</span>
              <span class="caption">
                contratos directos firmados en enero de {latestJanuary.period.slice(0, 4)}, antes de la restricción.
                {peakJanuary && peakJanuary.period !== latestJanuary.period && <> Solo enero de {peakJanuary.period.slice(0, 4)} tuvo más: {formatNumber(peakJanuary.contract_count)}.</>}
              </span>
            </p>
          )
        }
        <p>Cada barra es un mes y la franja sombreada es la restricción de contratación directa. En 2022 y 2026, la contratación se concentra en enero, casi se detiene durante la restricción y se recupera después. En los años de comparación enero también es el mes más alto, pero la contratación continúa durante el resto del año.</p>
        <div class="definition">
          <strong>Qué cuenta.</strong> Contratos de contratación directa del Distrito por mes de firma. El conteo
          siempre se publica; el valor del mes se oculta cuando no alcanza 5 contratos con valor o se podría
          despejar por resta.{/* R13: supresión de celdas pequeñas. */}
        </div>
      </article>
      <div>
        <Figure id="contratacion-directa-por-mes" number="3.1" />
        <p class="legend">
          <span><span class="swatch swatch--treatment"></span> Año con elecciones</span>
          <span><span class="swatch swatch--control"></span> Año de comparación</span>
          <span><span class="swatch swatch--band"></span> Restricción de contratación directa</span>
          <span><span class="swatch swatch--agreement"></span> Restricción de convenios interadministrativos</span>
        </p>
      </div>
    </div>
  </Screen>
  <Screen id="la-comparacion">
    <span slot="title">¿Es distinto en los años con restricción?</span>
    <p class="caption">4 · La comparación</p>
    <div class="pattern-grid">
      <article class="pattern-card">
        <p class="caption number">4.1</p>
        <h3>En los años con elecciones, la ventana de enero concentra más de la mitad de la contratación directa</h3>
        {
          latestTreatment && (
            <p class="big-number">
              <span class="big">{percent(latestTreatment)}</span>
              <span class="caption">
                en {latestTreatment.year} ({formatNumber(latestTreatment.cell.numerator ?? 0)} de {formatNumber(latestTreatment.cell.denominator ?? 0)} contratos).
                {baseControl.min && baseControl.max && <> En los años de comparación: de {percent(baseControl.min)} a {percent(baseControl.max)}.</>}
              </span>
            </p>
          )
        }
        <p>Cada barra es un año: la parte de su contratación directa que se firmó en la ventana de enero. Como la renovación de enero ocurre todos los años, lo que vale la pena mirar es la diferencia entre los años con elecciones y los de comparación. Por valor la diferencia es menor; sin convenios interadministrativos se mantiene.</p>
        <div class="definition">
          <strong>Qué mide.</strong>{/* I2 */} De los contratos directos firmados entre el 1 de enero y el
          {windows[0] ? ` ${formatDate(windows[0].denominator_end)}` : ' fin del periodo'}, la parte firmada en la
          ventana de enero, antes de que empezara la restricción.
          {firstControlWindow && <> En {firstControlWindow.year}, año de comparación, la ventana va del {formatDate(firstControlWindow.window_start)} al {formatDate(firstControlWindow.window_end)}.</>}
        </div>
      </article>
      <fieldset class="switch">
        <legend class="caption">Medida</legend>
        {
          switchOptions.map((option, index) => (
            <input class="switch-input" type="radio" name="medida" id={`medida-${option.id}`} checked={index === 0} />
          ))
        }
        <div class="switch-buttons">
          {switchOptions.map((option) => <label for={`medida-${option.id}`}>{option.label}</label>)}
        </div>
        <p class="legend">
          <span><span class="swatch swatch--treatment"></span> Año con elecciones</span>
          <span><span class="swatch swatch--control"></span> Año de comparación</span>
        </p>
        {
          switchOptions.map((option) => (
            <div class={`switch-panel panel-${option.id}`}>
              <Figure id={option.figure} number="4.1" />
              <p class="definition">{option.note}</p>
            </div>
          ))
        }
      </fieldset>
    </div>
  </Screen>
  <Screen id="la-objecion">
    <span slot="title">¿No es solo la renovación de enero?</span>
    <p class="caption">5 · La objeción</p>
    <p>En enero la Alcaldía renueva los contratos de prestación de servicios, así que un pico en enero podría ser solo esa renovación. Para revisarlo, se separa la proporción por tipo de contrato y se mira cuánto duran los contratos firmados en enero.</p>
    <div class="pattern-grid">
      <article class="pattern-card">
        <p class="caption number">5.1</p>
        <h3>En prestación de servicios, la proporción de enero es mayor en los años con elecciones</h3>
        {
          serviceTreatment && (
            <p class="big-number">
              <span class="big">{percent(serviceTreatment)}</span>
              <span class="caption">
                de la prestación de servicios directa de {serviceTreatment.year} se firmó en la ventana de enero ({formatNumber(serviceTreatment.cell.numerator ?? 0)} de {formatNumber(serviceTreatment.cell.denominator ?? 0)} contratos).
                {nonServiceSameYear && <> En el resto de tipos: {percent(nonServiceSameYear)} ({formatNumber(nonServiceSameYear.cell.numerator ?? 0)} de {formatNumber(nonServiceSameYear.cell.denominator ?? 0)}).</>}
              </span>
            </p>
          )
        }
        <p>Si el pico fuera solo la renovación, la prestación de servicios tendría una proporción parecida todos los años, y no es así: en los años con elecciones es mucho mayor. En el resto de tipos de contrato la proporción es más baja; 2022 no se distingue de los años de comparación y 2026 sí sube.</p>
        <div class="definition">
          <strong>Qué compara.</strong> La misma proporción de la pantalla anterior, separada por tipo de contrato: prestación de
          servicios frente al resto de tipos.
        </div>
      </article>
      <div>
        <Figure id="concentracion-enero-por-tipo" number="5.1" />
        <p class="legend">
          <span><span class="swatch swatch--filled"></span> Prestación de servicios</span>
          <span><span class="swatch swatch--outline"></span> Resto de tipos</span>
          <span><span class="swatch swatch--treatment"></span> Año con elecciones</span>
          <span><span class="swatch swatch--control"></span> Año de comparación</span>
        </p>
      </div>
    </div>
    <div class="pattern-grid">
      <article class="pattern-card">
        <p class="caption number">5.2</p>
        <h3>La duración de los contratos de enero no separa los años</h3>
        <p class="tag">No concluyente</p>
        {
          spansControl && (
            <p class="big-number">
              <span class="big">{percent(spansControl)}</span>
              <span class="caption">
                en {spansControl.year}, año de comparación ({formatNumber(spansControl.cell.numerator ?? 0)} de {formatNumber(spansControl.cell.denominator ?? 0)} contratos).
                {spansTreatment.length > 0 && <> En los años con elecciones: {spansTreatment.map((year) => `${percent(year)} en ${year.year}`).join(' y ')}.</>}
              </span>
            </p>
          )
        }
        <p>Casi todos los contratos firmados en enero terminan después de la restricción, haya elecciones o no. Como esta señal no distingue los años, no apoya ni contradice el hallazgo principal y no se usa para decidir.</p>
        <div class="definition">
          <strong>Qué mide.</strong> Parte de los contratos directos firmados en la ventana de enero cuyo plazo
          pactado termina después del fin de la restricción de referencia
          {referenceEnds.length > 0 && <> ({referenceEnds.map((window) => formatDate(window.reference_restriction_end)).join(' y ')} en los años con elecciones)</>}.
          Solo por número de contratos.
        </div>
      </article>
      <div>
        <Figure id="contratos-enero-despues-de-la-restriccion" number="5.2" />
        <p class="legend">
          <span><span class="swatch swatch--treatment"></span> Año con elecciones</span>
          <span><span class="swatch swatch--control"></span> Año de comparación</span>
        </p>
      </div>
    </div>
  </Screen>
  <Screen id="mas-alla-de-las-elecciones">
    <span slot="title">¿Qué otros patrones hay?</span>
    <p class="caption">6 · Más allá de las elecciones</p>
    <p>
      Además del hallazgo principal, el tablero publica otras señales sobre cómo contrata la Alcaldía. Elige un indicador, un año y, si quieres, una secretaría. Una cifra alta es una señal para revisar, no una prueba de que algo esté mal.
    </p>
    <Explorer client:visible data={explorer} />
    <div class="definition">
      <strong>Para leer con cuidado.</strong>{/* R13 */} Cuando una cifra se basa en menos de 5 contratos o procesos, se muestra «datos insuficientes» y su número. El año {explorerLastYear} es parcial{metadata && <>: llega hasta el {formatDate(metadata.cutoff_date)}</>}. «Un solo oferente» se cuenta por procesos y los asigna a la secretaría que los adelanta, que no siempre es la que pidió el bien. Las adiciones solo existen para 2022 y 2023, porque vienen de una fuente que se detiene en junio de 2023. La concentración de proveedores se mide por valor.
    </div>
  </Screen>
  <Screen id="como-leer-esto">
    <span slot="title">Cómo leer estas cifras</span>
    <p class="caption">7 · Qué significa y qué no</p>
    <div class="pattern-grid">
      <article class="pattern-card">
        <h3>Qué mide</h3>
        {/* I2, R10 a R12 */}
        <p>
          Para cada año se cuenta qué parte de la contratación directa de la Alcaldía se firmó en enero, antes de que empezara la
          restricción de la Ley de Garantías. Todos los años se miden sobre el mismo tramo, del 1 de enero a la fecha de corte de los datos{metadata && <> ({formatDate(metadata.cutoff_date)})</>}, para que la comparación sea justa.
        </p>
        <p>Es una proporción: si en un año se firman más contratos en total, la proporción no sube por eso. Cada cifra se muestra con el número de contratos en que se basa.</p>
      </article>
      <article class="pattern-card">
        <h3>Qué no significa</h3>
        <ul>
          <li>Adelantar contratos es legal: la ley restringe contratar durante el periodo, no antes. Estas cifras describen cómo se planea la contratación; no señalan una falta.</li>
          <li>Es una coincidencia con el calendario, no una prueba de causa. Los cambios de gobierno o de presupuesto también pueden influir.</li>
          <li>Hay solo dos años con elecciones presidenciales en los datos. Por eso el resultado es un patrón descriptivo, sin pruebas estadísticas.</li>
          <li>Medida por valor, la diferencia es menos clara que por número de contratos. Por eso la cifra principal es la del número de contratos.</li>
          <li>Cuando una cifra se basa en muy pocos contratos, el tablero muestra «datos insuficientes» para proteger la privacidad y evitar conclusiones débiles.</li>
        </ul>
      </article>
    </div>
    <h3>Qué tan completos están los datos</h3>
    <p>Los datos vienen de dos fuentes oficiales que se comparan entre sí. Estas son las advertencias que conviene conocer:</p>
    <ul class="quality-list">
      {
        months.length > 0 && threshold != null && (
          <li>
            {/* R15 */}
            <strong>Comparación entre fuentes.</strong> Entre {formatMonth(months[0]?.period ?? '')} y {formatMonth(months.at(-1)?.period ?? '')}, se revisó qué parte de los contratos aparece en las dos fuentes.
            {belowMonths.length > 0
              ? <> En {belowMonths.length} {belowMonths.length === 1 ? 'mes' : 'meses'} esa parte queda por debajo del {formatPercent(threshold)}, así que las cifras de ese periodo se leen con cuidado:</>
              : <> Ningún mes queda por debajo del {formatPercent(threshold)}.</>}
          </li>
        )
      }
    </ul>
    {
      monthRows.length > 0 && (
        <BarTable
          caption="Meses en que menos contratos aparecen en las dos fuentes"
          rows={monthRows}
          valueLabel="Contratos en ambas fuentes"
        />
      )
    }
    <ul class="quality-list">
      {
        truncated && (
          <li>
            {/* MEData truncado */}
            <strong>Registros incompletos.</strong> {formatNumber(truncated.count)} de {formatNumber(truncated.total)} filas de la fuente del Distrito
            {truncated.share != null && <> ({formatPercent(truncated.share)})</>} llegan cortadas desde el origen. Se usan solo para los datos que sí conservan.
          </li>
        )
      }
      {
        unassigned && (
          <li>
            {/* R8 */}
            <strong>Contratos sin secretaría.</strong> {formatNumber(unassigned.count)} de {formatNumber(unassigned.total)} contratos
            {unassigned.share != null && <> ({formatPercent(unassigned.share)})</>} no se pudieron asignar a una secretaría.
          </li>
        )
      }
      {
        exclusions && (
          <li>
            {/* R9 */}
            <strong>Procesos descartados.</strong> {formatNumber(exclusions.count)} de {formatNumber(exclusions.total)} procesos
            {exclusions.share != null && <> ({formatPercent(exclusions.share)})</>} no se usan al contar los que tuvieron un solo oferente, por no ser procesos de selección reales.
          </li>
        )
      }
    </ul>
  </Screen>
  {
    pending
      .filter((screen) => screen.id === 'hacia-2027')
      .map((screen) => (
        <Screen id={screen.id}>
          <p>Esta pantalla está en preparación.</p>
        </Screen>
      ))
  }
  <Screen id="fuentes">
    <span slot="title">De dónde salen los datos</span>
    <p class="caption">9 · Fuentes</p>
    <h3>Conjuntos de datos</h3>
    {
      metadata && (
        <ul class="quality-list">
          {metadata.sources.map((source) => (
            <li>
              <a href={source.url}>{source.name}</a> · licencia {source.license}
            </li>
          ))}
        </ul>
      )
    }
    {
      metadata && (
        <p>
          Fecha de corte: <strong>{formatDate(metadata.cutoff_date)}</strong>. Los datos que ves son una copia de esa fecha y no cambian mientras dura el concurso.
        </p>
      )
    }
    <h3>Código abierto y licencias</h3>
    <p>
      Todo el código, la copia de los datos y los textos están en un <a href={REPO_URL}>repositorio público</a>, para que cada cifra se pueda reconstruir. El código usa licencia MIT; los datos y los textos, CC BY-SA 4.0, porque las fuentes de SECOP II usan esa licencia.
    </p>
    <h3>Uso de inteligencia artificial</h3>
    <p>
      Se usó Claude (Anthropic) para investigar fuentes y metodología, validar la estructura de los conjuntos de datos, redactar la documentación de diseño y asistir en la escritura de código con Claude Code. Las decisiones de diseño, el análisis y los resultados fueron revisados por el equipo, que puede explicar cada parte de la solución.
    </p>
    <h3>Corrección y réplica</h3>
    <p>
      Si encuentras un error, escríbenos a <a href={`mailto:${CONTACT}`}><code class="contact">{CONTACT}</code></a>. Las correcciones se registran, con fecha y motivo, en <a href={`${REPO_URL}/blob/main/CORRECCIONES.md`}>CORRECCIONES.md</a>. Si la Alcaldía o una secretaría explica un patrón, esa explicación se publica junto a la cifra.
    </p>
  </Screen>
</Base>

