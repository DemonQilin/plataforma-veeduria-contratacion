---
import BarTable from '../components/BarTable.astro';
import type { BarRow } from '../components/BarTable.astro';
import Base from '../layouts/Base.astro';
import FindingCard from '../components/FindingCard.astro';
import Figure from '../components/Figure.astro';
import Screen from '../components/Screen.astro';
import { getMetadata } from '../lib/data';
import { formatDate, formatNumber, formatPercent } from '../lib/format';
import { SCREENS } from '../lib/screens';
import type { I2YearCell } from '../lib/selectors';
import { comparisonWindows, directAwardJanuary, i2Extremes, i2ByYear, restrictions } from '../lib/selectors';

const metadata = getMetadata();
const pending = SCREENS.slice(5);

// Portada (pantalla 1): solo elige celdas de data/outputs/ (S6). Los anchos de barra
// son una escala visual, no una cifra publicada.
const roleLabel = (role: I2YearCell['role']) => (role === 'treatment' ? 'Elecciones' : 'Comparación');
const tone = (role: I2YearCell['role']): 'treatment' | 'control' => (role === 'treatment' ? 'treatment' : 'control');
const percent = (year: I2YearCell | undefined) =>
  year?.cell.ratio == null ? 'datos insuficientes' : formatPercent(year.cell.ratio);
const SCALE = 72;
const ratioRows = (years: I2YearCell[], withN = false): BarRow[] =>
  years.map((year) => ({
    label: String(year.year),
    sub: roleLabel(year.role),
    display: percent(year),
    note: withN
      ? `${formatNumber(year.cell.numerator ?? 0)} de ${formatNumber(year.cell.denominator ?? 0)} contratos`
      : undefined,
    width: (year.cell.ratio ?? 0) * SCALE,
    tone: tone(year.role),
  }));
const descriptionOf = (rows: readonly BarRow[]) =>
  rows.map((row) => `${row.label}, ${row.display}${row.note ? ` (${row.note})` : ''}`).join('; ');

const base = i2ByYear({ variant: null, measure: 'count' });
const baseRows = ratioRows(base, true);
const baseControl = i2Extremes(base, 'control');

const service = i2ByYear({ variant: 'service_contract', measure: 'count' });
const serviceRows = ratioRows(service);
const nonService = i2ByYear({ variant: 'non_service_contract', measure: 'count' });
const nonServiceControl = i2Extremes(nonService, 'control');

const spans = i2ByYear({ variant: 'spans_restriction', measure: 'count' });
const spansRows = ratioRows(spans);
const spans2025 = spans.find((year) => year.year === 2025);

const january = directAwardJanuary();
const januaryMax = Math.max(...january.map((row) => row.contract_count));
const roleOfYear = new Map(base.map((year) => [String(year.year), year.role]));
const januaryRows: BarRow[] = january.map((row) => {
  const role = roleOfYear.get(row.period.slice(0, 4));
  return {
    label: `Enero ${row.period.slice(0, 4)}`,
    sub: roleLabel(role),
    display: formatNumber(row.contract_count),
    width: (row.contract_count / januaryMax) * SCALE,
    tone: tone(role),
  };
});

const list = restrictions();
const timelineStart = Date.UTC(Number(list[0]?.start.slice(0, 4)), 0, 1);
const timelineEnd = Date.UTC(Number(list.at(-1)?.end.slice(0, 4)) + 1, 0, 1);
const place = (iso: string) => ((Date.parse(`${iso}T00:00:00Z`) - timelineStart) / (timelineEnd - timelineStart)) * 100;
const scopeLabel = { direct_award: 'Contratación directa', interadministrative: 'Convenios' } as const;
const timelineRows: BarRow[] = list.map((item) => ({
  label: item.start.slice(0, 4) === item.end.slice(0, 4) ? item.start.slice(0, 4) : `${item.start.slice(0, 4)}–${item.end.slice(0, 4)}`,
  sub: `${scopeLabel[item.scope]}${item.status === 'upcoming' ? ' · próxima' : ''}`,
  display: `del ${formatDate(item.start)} al ${formatDate(item.end)}`,
  width: place(item.end) - place(item.start),
  offset: place(item.start),
  tone: item.scope === 'direct_award' ? 'restriction' : 'dashed',
}));
const latestJanuary = january.at(-1);
const peakJanuary = january.toSorted((a, b) => b.contract_count - a.contract_count)[0];
const directRestrictions = restrictions('direct_award');
const ruleSource = directRestrictions[0]?.sources[0];

// Pantalla 4: solo elige celdas de I2 y fechas de comparison_windows (S6).
const latestTreatment = base.findLast((year) => year.role === 'treatment');
const windows = comparisonWindows();
const firstControlWindow = windows.find((window) => window.role === 'control');
const switchOptions = [
  { id: 'numero', label: 'Por número de contratos', figure: 'concentracion-enero-por-numero', note: 'Cifra titular: definición base, por número de contratos.' },
  { id: 'valor', label: 'Por valor', figure: 'concentracion-enero-por-valor', note: 'Por valor se usa el valor inicial, sin operaciones de crédito público. La señal es menos clara que por número; por eso la cifra titular es la del número de contratos.' },
  { id: 'sin-interadministrativos', label: 'Sin interadministrativos', figure: 'concentracion-enero-sin-interadministrativos', note: 'Sin convenios interadministrativos en el numerador ni en el denominador, porque su peso cambia entre años: en 2023 no hubo de julio a octubre por la restricción local.' },
] as const;
---

<Base
  title="Veeduría de contratación · Alcaldía de Medellín"
  description="Señales para revisar la contratación directa de la Alcaldía de Medellín alrededor de la Ley de Garantías."
>
  <Screen id="portada">
    <span slot="title" class="display">
      En 2022 y 2026, más de la mitad de la contratación directa se firmó en enero.
    </span>
    <p class="caption">
      {
        metadata
          ? `Hallazgo principal · Medellín · fecha de corte ${formatDate(metadata.cutoff_date)}.`
          : 'Los datos todavía no están disponibles.'
      }
    </p>
    <p class="caption">
      Antes de que empezara la restricción de la Ley de Garantías. Del 1 de enero
      {metadata ? ` al ${formatDate(metadata.cutoff_date)}` : ''}, por número de contratos.
    </p>
    <p><a class="start" href="#la-regla">Empezar el recorrido</a></p>

    <div class="cover-grid">
      <FindingCard screenId="la-comparacion" crumb="4 · La comparación" title="Contratación directa firmada en la ventana de enero" more="Ver la comparación">
        <BarTable caption={`Contratación directa firmada en la ventana de enero, por número de contratos: ${descriptionOf(baseRows)}.`} rows={baseRows} valueLabel="Proporción" />
        {baseControl.min && baseControl.max && (
          <p>En los años sin restricción, la proporción estuvo entre {percent(baseControl.min)} y {percent(baseControl.max)}.</p>
        )}
      </FindingCard>
    </div>

    <h2 class="cover-h2">Lo que muestran los datos</h2>
    <div class="cover-grid cover-grid--pair">
      <FindingCard screenId="la-regla" crumb="2 · La regla" title="La contratación directa se restringió dos veces: en 2022 y en 2026" more="Ver la regla">
        <BarTable caption={`Periodos de restricción: ${timelineRows.map((row) => `${row.sub} ${row.display}`).join('; ')}.`} rows={timelineRows} valueLabel="Periodo" showValue={false} />
        <p>Del {directRestrictions.map((item) => `${formatDate(item.start)} al ${formatDate(item.end)}`).join(' y del ')}.</p>
      </FindingCard>

      <FindingCard screenId="el-patron" crumb="3 · El patrón" title="Enero es el mes con más contratación directa de cada año" more="Ver el patrón">
        <BarTable caption={`Contratos directos firmados en enero: ${descriptionOf(januaryRows)}.`} rows={januaryRows} valueLabel="Contratos" />
        <p class="placeholder">[Texto pendiente: frase del conteo mensual durante las restricciones (T4).]</p>
      </FindingCard>

      <FindingCard screenId="la-objecion" crumb="5 · La objeción" title="En prestación de servicios, la proporción de enero es mayor en los años con elecciones" more="Ver la objeción">
        <BarTable caption={`Prestación de servicios, proporción firmada en la ventana de enero: ${descriptionOf(serviceRows)}.`} rows={serviceRows} valueLabel="Proporción" />
        {nonServiceControl.min && nonServiceControl.max && (
          <p>En el resto de tipos de contrato va de {percent(nonServiceControl.min)} a {percent(nonServiceControl.max)}.</p>
        )}
      </FindingCard>

      <FindingCard screenId="la-objecion" crumb="5 · La objeción" title="La duración de los contratos de enero no separa los años" more="Ver la objeción">
        <p class="tag">No concluyente</p>
        <BarTable caption={`Contratos de enero que terminan después de la restricción de referencia: ${descriptionOf(spansRows)}.`} rows={spansRows} valueLabel="Proporción" />
        {spans2025 && (
          <p>Contratos de enero que terminan después de la restricción. En 2025, año de comparación, también llega a {percent(spans2025)}.</p>
        )}
      </FindingCard>
    </div>
    <p class="placeholder">[Texto pendiente del compañero: los titulares de las tarjetas son un borrador.]</p>
  </Screen>
  <Screen id="la-regla">
    <span slot="title">¿Qué es la Ley de Garantías?</span>
    <p class="caption">2 · La regla</p>
    <div class="rule-intro">
      <p class="placeholder">[Texto pendiente del compañero: explicación en dos frases de la Ley de Garantías.]</p>
      <div class="definition">
        <strong>Qué restringe.</strong> En el calendario que usa el pipeline, la restricción de contratación directa
        corresponde a las elecciones presidenciales (2022 y 2026); la de convenios interadministrativos, a las
        elecciones locales (2023 y 2027) y a las de Congreso (2026).
        {ruleSource && <> Fuente: {ruleSource}.</>}
      </div>
    </div>
    <Figure id="periodos-de-restriccion" number="2.1" />
    <p class="legend">
      <span><span class="swatch swatch--direct"></span> Restricción de la contratación directa</span>
      <span><span class="swatch swatch--agreement"></span> Restricción de convenios interadministrativos</span>
    </p>
  </Screen>
  <Screen id="el-patron">
    <span slot="title">¿Qué pasa con la contratación alrededor de esas fechas?</span>
    <p class="caption">3 · El patrón</p>
    <div class="pattern-grid">
      <article class="pattern-card">
        <p class="caption number">3.1</p>
        <h2>Enero es el mes con más contratación directa de cada año</h2>
        {
          latestJanuary && (
            <p class="big-number">
              <span class="big">{formatNumber(latestJanuary.contract_count)}</span>
              <span class="caption">
                contratos directos firmados en enero de {latestJanuary.period.slice(0, 4)}, antes de la restricción.
                {peakJanuary && peakJanuary.period !== latestJanuary.period && <> Solo enero de {peakJanuary.period.slice(0, 4)} tuvo más: {formatNumber(peakJanuary.contract_count)}.</>}
              </span>
            </p>
          )
        }
        <p class="placeholder">[Texto pendiente del compañero: cómo leer el gráfico y qué se observa en enero.]</p>
        <div class="definition">
          <strong>Qué cuenta.</strong> Contratos de contratación directa del Distrito por mes de firma. El conteo
          siempre se publica; el valor del mes se oculta cuando no alcanza 5 contratos con valor o se podría
          despejar por resta (R13).
        </div>
      </article>
      <div>
        <Figure id="contratacion-directa-por-mes" number="3.1" />
        <p class="legend">
          <span><span class="swatch swatch--treatment"></span> Año con elecciones</span>
          <span><span class="swatch swatch--control"></span> Año de comparación</span>
          <span><span class="swatch swatch--band"></span> Restricción de contratación directa</span>
          <span><span class="swatch swatch--agreement"></span> Restricción de convenios interadministrativos</span>
        </p>
      </div>
    </div>
  </Screen>
  <Screen id="la-comparacion">
    <span slot="title">¿Es distinto en los años con restricción?</span>
    <p class="caption">4 · La comparación</p>
    <div class="pattern-grid">
      <article class="pattern-card">
        <p class="caption number">4.1</p>
        <h2>En los años con elecciones, la ventana de enero concentra más de la mitad de la contratación directa</h2>
        {
          latestTreatment && (
            <p class="big-number">
              <span class="big">{percent(latestTreatment)}</span>
              <span class="caption">
                en {latestTreatment.year} ({formatNumber(latestTreatment.cell.numerator ?? 0)} de {formatNumber(latestTreatment.cell.denominator ?? 0)} contratos).
                {baseControl.min && baseControl.max && <> En los años de comparación: de {percent(baseControl.min)} a {percent(baseControl.max)}.</>}
              </span>
            </p>
          )
        }
        <p class="placeholder">[Texto pendiente del compañero: cómo leer la comparación.]</p>
        <div class="definition">
          <strong>Qué mide (I2).</strong> De los contratos directos firmados entre el 1 de enero y el
          {windows[0] ? ` ${formatDate(windows[0].denominator_end)}` : ' fin del periodo'}, la parte firmada en la
          ventana de enero, antes de que empezara la restricción.
          {firstControlWindow && <> En {firstControlWindow.year}, año de comparación, la ventana va del {formatDate(firstControlWindow.window_start)} al {formatDate(firstControlWindow.window_end)}.</>}
        </div>
      </article>
      <fieldset class="switch">
        <legend class="caption">Medida</legend>
        {
          switchOptions.map((option, index) => (
            <input class="switch-input" type="radio" name="medida" id={`medida-${option.id}`} checked={index === 0} />
          ))
        }
        <div class="switch-buttons">
          {switchOptions.map((option) => <label for={`medida-${option.id}`}>{option.label}</label>)}
        </div>
        <p class="legend">
          <span><span class="swatch swatch--treatment"></span> Año con elecciones</span>
          <span><span class="swatch swatch--control"></span> Año de comparación</span>
        </p>
        {
          switchOptions.map((option) => (
            <div class={`switch-panel panel-${option.id}`}>
              <Figure id={option.figure} number="4.1" />
              <p class="definition">{option.note}</p>
            </div>
          ))
        }
      </fieldset>
    </div>
  </Screen>
  <Screen id="la-objecion">
    <p>[Texto pendiente: la objeción (T8).]</p>
  </Screen>
  {
    pending.map((screen) => (
      <Screen id={screen.id}>
        <p>[Texto pendiente: pantalla fuera del alcance de este bloque.]</p>
      </Screen>
    ))
  }
</Base>

<style>
  .display {
    font-size: var(--font-size-h1);
    line-height: var(--line-height-h1);
  }

  .start {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 24px;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    text-decoration: none;
  }

  .cover-grid {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-4);
  }

  .cover-h2 {
    margin-top: var(--space-4);
  }

  .cover-grid--pair {
    margin-top: 0;
  }

  .tag {
    width: fit-content;
    padding: 2px 10px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-md);
    font-weight: 700;
    font-size: var(--font-size-caption);
  }

  .rule-intro {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .definition {
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-md);
    background: var(--surface);
    font-size: var(--font-size-caption);
    line-height: var(--line-height-caption);
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-3);
    color: var(--ink-muted);
    font-size: var(--font-size-caption);
  }

  .swatch {
    display: inline-block;
    width: 20px;
    height: 12px;
    border-radius: 2px;
    vertical-align: middle;
  }

  .swatch--direct {
    background: var(--chart-restriction);
    border: 2px solid var(--chart-treatment);
  }

  .swatch--treatment {
    background: var(--chart-treatment);
  }

  .swatch--control {
    background: var(--chart-control);
  }

  .swatch--band {
    background: var(--chart-restriction);
    border: 1px solid var(--hairline);
  }

  .swatch--agreement {
    border: 1.5px dashed var(--chart-axis);
  }

  .pattern-grid {
    display: grid;
    gap: var(--space-3);
    margin-top: var(--space-3);
  }

  .pattern-card {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-3);
    background: var(--surface-raised);
    border: 2px solid var(--ink);
    border-radius: var(--radius-md);
  }

  .pattern-card h2,
  .pattern-card p {
    margin: 0;
  }

  .pattern-card .number {
    color: var(--accent);
  }

  .big-number {
    display: grid;
    gap: var(--space-1);
  }

  .big {
    font-size: 56px;
    line-height: 56px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .placeholder {
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-3);
    border: 1px dashed var(--hairline);
    border-radius: var(--radius-md);
    color: var(--ink-muted);
    font-size: var(--font-size-caption);
  }

  .switch {
    display: grid;
    gap: var(--space-2);
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .switch-input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .switch-buttons {
    display: none;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .switch-buttons label {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 14px;
    border: 1px solid var(--ink);
    border-radius: var(--radius-md);
    background: var(--surface-raised);
    cursor: pointer;
  }

  @supports selector(:has(*)) {
    .switch-buttons {
      display: flex;
    }

    .switch:has(.switch-input:focus-visible) .switch-buttons {
      outline: 2px solid var(--accent);
      outline-offset: 2px;
    }

    .switch:not(:has(#medida-numero:checked)) .panel-numero,
    .switch:not(:has(#medida-valor:checked)) .panel-valor,
    .switch:not(:has(#medida-sin-interadministrativos:checked)) .panel-sin-interadministrativos {
      display: none;
    }

    .switch:has(#medida-numero:checked) label[for='medida-numero'],
    .switch:has(#medida-valor:checked) label[for='medida-valor'],
    .switch:has(#medida-sin-interadministrativos:checked) label[for='medida-sin-interadministrativos'] {
      background: var(--ink);
      color: var(--surface-raised);
      font-weight: 700;
    }
  }

  @supports not selector(:has(*)) {
    .switch-input {
      display: none;
    }
  }

  @media (min-width: 900px) {
    .display {
      font-size: var(--font-size-display);
      line-height: var(--line-height-display);
    }

    .rule-intro {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .cover-grid--pair {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      align-items: start;
    }

    .pattern-grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      align-items: start;
    }
  }
</style>
