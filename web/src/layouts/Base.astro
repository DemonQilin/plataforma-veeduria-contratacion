---
import { Font } from 'astro:assets';
import { SCREENS } from '../lib/screens';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- Durante el concurso el sitio no se indexa (docs/producto.md). -->
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={`favicon.svg`} />
    <Font cssVariable="--font-sans" preload />
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <div class="layout">
      <nav class="index" aria-label="Pantallas">
        <ol>
          {
            SCREENS.map((screen, i) => (
              <li>
                <a href={`${base}#${screen.id}`}>
                  {i + 1}. {screen.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      <main id="contenido" class="content">
        <slot />
      </main>
    </div>
  </body>
</html>

<script>
  // Mejora progresiva (ADR 0054): marca en el índice la pantalla que se está leyendo.
  const links = new Map<string, HTMLAnchorElement>();
  document.querySelectorAll<HTMLAnchorElement>('.index a').forEach((link) => {
    const id = link.hash.slice(1);
    if (id) links.set(id, link);
  });
  const mark = (id: string) => {
    links.forEach((link, key) => {
      if (key === id) link.setAttribute('aria-current', 'location');
      else link.removeAttribute('aria-current');
    });
  };
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        const visible = entries.find((entry) => entry.isIntersecting);
        if (visible) mark(visible.target.id);
      },
      { rootMargin: '-40% 0px -55% 0px' },
    );
    document.querySelectorAll('section.screen').forEach((section) => observer.observe(section));
  }
</script>